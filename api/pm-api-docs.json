    "components": {
        "schemas": {
            "Layer": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "matcherMethod": {
                        "type": "string"
                    },
                    "batchSizeConfig": {
                        "type": "array",
                        "items": {
                            "type": "integer",
                            "format": "int32"
                        }
                    },
                    "maxBatches": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "encodingMethod": {
                        "type": "string"
                    },
                    "updateMatcher": {
                        "type": "boolean"
                    },
                    "linkSelectionStrategy": {
                        "type": "string",
                        "enum": [
                            "SORTED",
                            "ALTERNATING",
                            "BUCKETS",
                            "EXTERNAL_SERVICE"
                        ]
                    },
                    "updateType": {
                        "type": "string",
                        "enum": [
                            "NEW_IMPROVED",
                            "UPPER_IMPROVED",
                            "IMPROVED",
                            "CR_ONLY"
                        ]
                    },
                    "initialThreshold": {
                        "type": "number",
                        "format": "double"
                    },
                    "stopUpdateWhenClericalReviewBudgetIsReached": {
                        "type": "boolean"
                    },
                    "budget": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "errorRate": {
                        "type": "number",
                        "format": "double"
                    },
                    "attributeWeightMethod": {
                        "type": "string"
                    },
                    "initialAttributeWeights": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "number",
                            "format": "double"
                        }
                    },
                    "attributeErrorRates": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "number",
                            "format": "double"
                        }
                    },
                    "projectId": {
                        "type": "string"
                    },
                    "batchSize": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "currentBatch": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "numberOfReviews": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "active": {
                        "type": "boolean"
                    }
                }
            },
            "MultiLayerProtocol": {
                "type": "object",
                "properties": {
                    "protocolId": {
                        "type": "string"
                    },
                    "layers": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Layer"
                        }
                    },
                    "linkageProject": {
                        "type": "string"
                    },
                    "plaintextDatasetId": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "initialDatasetId": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "lastUpdate": {
                        "type": "string"
                    },
                    "stepHistory": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ProcessingStep"
                        }
                    },
                    "stepQueue": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ProcessingStep"
                        }
                    }
                }
            },
            "PhaseProgress": {
                "type": "object",
                "properties": {
                    "done": {
                        "type": "boolean"
                    },
                    "progress": {
                        "type": "number",
                        "format": "double"
                    },
                    "description": {
                        "type": "string"
                    }
                }
            },
            "ProcessingStep": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string"
                    },
                    "properties": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        }
                    },
                    "phaseProgress": {
                        "$ref": "#/components/schemas/PhaseProgress"
                    },
                    "reportGroups": {
                        "type": "object",
                        "additionalProperties": {
                            "$ref": "#/components/schemas/ReportGroup"
                        }
                    }
                }
            },
            "Report": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "TEXT",
                            "TABLE"
                        ]
                    },
                    "report": {
                        "type": "string"
                    },
                    "table": {
                        "$ref": "#/components/schemas/SerializableTable"
                    }
                }
            },
            "ReportGroup": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "reports": {
                        "type": "object",
                        "additionalProperties": {
                            "$ref": "#/components/schemas/Report"
                        }
                    }
                }
            },
            "SerializableTable": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "header": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "types": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "data": {
                        "type": "array",
                        "items": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "EncodedTransferRequestDto": {
                "type": "object",
                "properties": {
                    "dataOwnerDatasetId": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "linkageUnitDatasetId": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "encoding": {
                        "$ref": "#/components/schemas/EncodingIdDto"
                    }
                },
                "required": [
                    "dataOwnerDatasetId",
                    "encoding"
                ]
            },
            "EncodingIdDto": {
                "type": "object",
                "description": "ID of an encoding scheme",
                "properties": {
                    "method": {
                        "type": "string",
                        "description": "Name of the encoding scheme"
                    },
                    "project": {
                        "type": "string",
                        "description": "Unique name of the record-linkage project"
                    }
                }
            },
            "ProtocolExecutionDto": {
                "type": "object",
                "properties": {
                    "protocolId": {
                        "type": "string"
                    },
                    "numberOfSteps": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "stepToStop": {
                        "type": "string"
                    }
                }
            },
            "DatasetCsvDto": {
                "type": "object",
                "properties": {
                    "path": {
                        "type": "string",
                        "minLength": 1
                    },
                    "datasetDto": {
                        "$ref": "#/components/schemas/DatasetDto"
                    }
                },
                "required": [
                    "path"
                ]
            },
            "DatasetDto": {
                "type": "object",
                "properties": {
                    "datasetId": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "datasetName": {
                        "type": "string"
                    },
                    "plaintextDatasetId": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "encodingIdDto": {
                        "$ref": "#/components/schemas/EncodingIdDto"
                    },
                    "properties": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        }
                    }
                }
            },
            "ChangeFilter": {
                "type": "object",
                "properties": {
                    "minChanges": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "maxChanges": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "changedAttributes": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "unchangedAttributes": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "requireAllListedAttributes": {
                        "type": "boolean"
                    }
                }
            },
            "ContentFilter": {
                "type": "object",
                "properties": {
                    "recordSelectorString": {
